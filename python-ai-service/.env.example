# Flask Environment
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Server
HOST=127.0.0.1
PORT=5001

# Apriori Parameters
MIN_SUPPORT=0.05
MIN_CONFIDENCE=0.25
MIN_LIFT=1.0

# API Key (optional, for production)
# API_KEY=your-api-key-here

# CORS
CORS_ORIGINS=localhost,127.0.0.1,192.168.1.100

# Laravel Integration
LARAVEL_BASE_URL=http://localhost:8000
# LARAVEL_API_TOKEN=your-token-here
